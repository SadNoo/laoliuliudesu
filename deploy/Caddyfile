{
  admin off
}

{$LAOLIULIU_DOMAIN} {
  encode zstd gzip

  request_body {
    max_size 2MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }

  reverse_proxy api:8000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 120s
    }
  }

  log {
    output stdout
    format json
  }
}
